# Server Configuration
# HOST - IP address the server listens on (default: 127.0.0.1)
# Use 0.0.0.0 to make the server accessible from all network interfaces
HOST=127.0.0.1

# E2E Test Configuration
E2E_AUTH_TOKEN=your_api_key_here
E2E_BASE_URL=https://api.z.ai/api/anthropic
E2E_API_TIMEOUT_MS=3000000
E2E_MODEL=sonnet
